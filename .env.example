# =============================================================================
# THE EMBER TABLE — Environment Configuration Template (.env.example)
# Concept by Kadam Digital
# =============================================================================
# NOTE: All variables below are PUBLIC frontend variables exposed to the client
# bundle via Vite's `import.meta.env` mechanism.
# Do NOT place secret tokens, payment gateway private keys, or database credentials here.
# =============================================================================

# Public WhatsApp Business number for order handoff (e.g., "919876543210")
# Leave blank or unconfigured to activate the interactive demo fallback modal.
VITE_WHATSAPP_NUMBER=

# Public contact phone number displayed in navbar and contact cards
VITE_RESTAURANT_PHONE=+91 98765 43210

# Public reservations email displayed in footer and contact section
VITE_RESTAURANT_EMAIL=reservations@theembertable.concept
